SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products

# Optional custom shop-domain suffix, e.g. my.shop.dev. Uses Shopify domainTransformations.
SHOP_CUSTOM_DOMAIN=

DATABASE_URL=postgres://app:password@localhost:5440/app

# Required in production. Generate with: openssl rand -base64 32
SHOPIFY_TOKEN_ENCRYPTION_KEY=
