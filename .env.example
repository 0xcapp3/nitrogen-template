SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products

DATABASE_URL=postgres://app:password@localhost:5440/app

# Required in production. Generate with: openssl rand -base64 32
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Optional. Custom shop domain suffix (e.g. custom.domain.com) for split-domain
# setups. Accepted as a valid shop domain via `domainTransformations`.
SHOP_CUSTOM_DOMAIN=
