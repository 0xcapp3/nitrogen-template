# Public app identity. Shopify CLI supplies URL/key in development.
SHOPIFY_API_KEY=
# SHOPIFY_APP_URL=
NITROGEN_PLATFORM_API_URL=http://127.0.0.1:22300/api/v1
# In the two app-specific names below, NITROGEN is a placeholder for your app
# prefix (e.g. MCH or VTO). Rename them here, in the code and in deployment
# configuration together; the template currently reads the NITROGEN names.
# Keep NITROGEN_PLATFORM_API_URL unchanged: it is shared across Nitrogen apps.
NITROGEN_PLATFORM_APPLICATION_KEY=
# Server-only 64 lowercase hex characters provisioned on Platform.
NITROGEN_PLATFORM_SERVICE_TOKEN=
