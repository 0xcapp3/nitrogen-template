{
  "name": "app",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "yarn setup && yarn start",
    "setup": "yarn db:migrate",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "check": "yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/shopify-api": "^14.0.1",
    "@shopify/shopify-app-react-router": "^2.1.0",
    "@shopify/shopify-app-session-storage": "^6.0.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "isbot": "^5.2.2",
    "postgres": "^3.4.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/polaris-types": "^1.0.7",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "graphql-config": "^5.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  }
}
